# =====================================
# Database
# =====================================

# Database filename (optional)
# Default: wireless_drive.db
DB_NAME=wireless_drive.db


# =====================================
# Security
# =====================================

# JWT signing secret (required)
JWT_SECRET=hygtfdrseawlpkojihugy

# Media stream signing secret (required)
STREAM_SECRET=hygtfdrdesertwlpkojihugy


# =====================================
# Storage
# =====================================

# Base directory for all application data (required)
# Make sure this points to the correct location to avoid writing
# large amounts of data to the wrong directory.
BASE_PATH=/storage/emulated/0/databases/wirelessDrive

# Uploads directory name (relative to BASE_PATH)
UPLOADS_DIR=uploads

# Thumbnails directory name (relative to BASE_PATH)
THUMBS_DIR=thumbs


# =====================================
# FFmpeg
# =====================================

# FFmpeg executable path (optional)
# Default: Uses the system-installed ffmpeg if available.
FFMPEG_PATH=/data/local/tmp/wirelessDrive/ffmpeg

# FFprobe executable path (optional)
# Default: Uses the system-installed ffprobe if available.
FFPROBE_PATH=/data/local/tmp/wirelessDrive/ffprobe


# =====================================
# Server
# =====================================

# HTTP server port (optional)
# Default: 8085
PORT=8085


# =====================================
# Thumbnail API
# =====================================

# External thumbnail generation service (optional)
# Only required if FFmpeg is not available on this server.
# See the README for setup instructions.
THUMBNAIL_API_URL=http://192.168.0.162:8086